<section
  class="font-roboto-condensed bg-black"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {% if section.settings.heading != blank %}
    <h2 class="text-center text-[#6EC7B3] uppercase font-medium text-[20px] md:text-[24px] leading-[100%] tracking-[0.08em] mb-[48px]">
      {{ section.settings.heading }}
    </h2>
  {% endif %}
  <div class="max-w-[1000px] mx-auto px-[20px] grid grid-cols-2 md:grid-cols-4 gap-x-[24px] gap-y-[40px]">
    {% for block in section.blocks %}
      {% if block.settings.logo != blank %}
        <div
          class="flex items-center justify-center h-[64px] md:h-[80px]"
          style="--logo-scale: {{ block.settings.scale | default: 100 | divided_by: 100.0 }};"
          {{ block.shopify_attributes }}
        >
          <img
            src="{{ block.settings.logo | image_url: height: 160 }}"
            alt="{{ block.settings.logo.alt | escape }}"
            class="max-h-[calc(42px*var(--logo-scale,1))] md:max-h-[calc(52px*var(--logo-scale,1))] max-w-[calc(130px*var(--logo-scale,1))] md:max-w-[calc(170px*var(--logo-scale,1))] w-auto h-auto object-contain mix-blend-screen"
            width="{{ block.settings.logo.aspect_ratio | times: 52 | round }}"
            height="52"
            loading="lazy"
          >
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "DD Partners",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Official partners"
    },
    {
      "type": "paragraph",
      "content": "Logos display in a grid: 4 per row on desktop, 2 per row on mobile. Logos with a solid black background blend into the section automatically."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "range",
          "id": "scale",
          "min": 60,
          "max": 160,
          "step": 5,
          "unit": "%",
          "label": "Logo size",
          "info": "Fine-tune so logos look visually balanced.",
          "default": 100
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "DD Partners",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
