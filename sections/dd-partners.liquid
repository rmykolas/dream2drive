<section
  class="font-roboto-condensed bg-black overflow-hidden"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {% if section.settings.heading != blank %}
    <h2 class="text-center text-[#6EC7B3] uppercase font-medium text-[20px] md:text-[24px] leading-[100%] tracking-[0.08em] mb-[48px]">
      {{ section.settings.heading }}
    </h2>
  {% endif %}
  <div class="flex items-center gap-[80px] overflow-hidden">
    {% for i in (1..3) %}
      <div class="flex items-center gap-[80px] shrink-0 animate-scroll" {% if i > 1 %}aria-hidden="true"{% endif %}>
        {% for block in section.blocks %}
          {% if block.settings.logo != blank %}
            <img
              src="{{ block.settings.logo | image_url: height: 96 }}"
              alt="{{ block.settings.logo.alt | escape }}"
              class="h-[36px] md:h-[44px] w-auto max-w-none mix-blend-screen"
              width="{{ block.settings.logo.aspect_ratio | times: 44 | round }}"
              height="44"
              loading="lazy"
              {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}
            >
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "DD Partners",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Official partners"
    },
    {
      "type": "paragraph",
      "content": "Logos scroll in a continuous marquee. Logos with a solid black background blend into the section automatically."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "DD Partners",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
