{% comment %}
  Footer Section
  - Block-based: add/remove/reorder columns in the theme editor
  - Block types: text column, menu column
{% endcomment %}

<footer class="relative z-12 font-roboto-condensed bg-[#0F0F0F]" style="z-index: 12;">
  <div class="py-[80px] px-[16px] md:px-[32px]">
    <div class="max-w-[1280px] mx-auto">
      <div class="flex justify-between flex-wrap gap-[50px]">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'text' %}
              <div class="max-w-[240px]" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h4 class="text-[#C8C9CC] text-[24px] font-medium leading-[100%] uppercase mb-[30px] tracking-[-0.01em]">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}
                <p class="text-[#C8C9CC] text-[18px] leading-[160%] font-normal">
                  {{ block.settings.text | newline_to_br }}
                </p>
              </div>
            {% when 'menu' %}
              <div class="max-w-[240px]" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h4 class="text-[#C8C9CC] text-[24px] font-medium leading-[100%] uppercase mb-[30px] tracking-[-0.01em]">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}
                <ul class="list-none p-0 m-0">
                  {% for link in block.settings.menu.links %}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="text-[#C8C9CC] text-[18px] leading-[160%] font-normal no-underline hover:text-white"
                      >
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "max_blocks": 8,
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Line breaks are kept.",
          "default": "Text"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Information"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Section",
      "category": "Footer",
      "blocks": [
        { "type": "text" },
        { "type": "text" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
