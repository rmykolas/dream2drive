{%- liquid
  assign topic = section.settings.topic
  if topic == blank and product
    assign topic = product.title
  endif
-%}
<style>
  .ci{background:{{ section.settings.bg }};color:#f3f4f7;padding:{{ section.settings.padding }}px 20px}
  .ci *{box-sizing:border-box}
  .ci__in{max-width:1100px;margin:0 auto;display:flex;gap:24px;align-items:center;justify-content:space-between;flex-wrap:wrap;border:1.5px solid #3a3d4b;border-radius:14px;padding:26px clamp(18px,3vw,36px)}
  .ci__txt{flex:1;min-width:260px}
  .ci__txt h2{margin:0 0 6px;font-size:clamp(22px,2.6vw,30px);line-height:1.15;color:#f3f4f7}
  .ci__txt div,.ci__txt p{margin:0;color:#a9adbb;font-size:15px;line-height:1.55}
  .ci__btn{font:inherit;font-weight:700;font-size:16px;border:0;border-radius:8px;min-height:50px;padding:0 26px;background:{{ section.settings.accent }};color:#14262a;cursor:pointer}
  .ci dialog{border:0;border-radius:14px;padding:0;max-width:520px;width:calc(100% - 28px);background:#262833;color:#f3f4f7}
  .ci dialog::backdrop{background:rgba(10,12,20,.65)}
  .ci__form{padding:24px;display:grid;gap:12px}
  .ci__form h3{margin:0;font-size:22px;color:#f3f4f7}
  .ci__form p{margin:0;color:#a9adbb;font-size:14px;line-height:1.5}
  .ci__row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .ci label{display:block;font-size:13px;color:#a9adbb;margin-bottom:5px}
  .ci input,.ci textarea,.ci select{width:100%;font:inherit;font-size:16px;padding:11px 12px;border-radius:8px;border:1.5px solid #3a3d4b;background:#1f212b;color:#f3f4f7}
  .ci textarea{min-height:130px;resize:vertical}
  .ci input:focus,.ci textarea:focus,.ci select:focus{outline:none;border-color:{{ section.settings.accent }}}
  .ci__acts{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
  .ci__ghost{font:inherit;font-weight:600;font-size:15px;border:1.5px solid #3a3d4b;background:none;color:#f3f4f7;border-radius:8px;min-height:48px;padding:0 18px;cursor:pointer}
  .ci__ok{background:#1c3b35;border:1px solid {{ section.settings.accent }};border-radius:8px;padding:12px 14px;color:#d8f6ef;font-size:15px}
  .ci__err{background:#3b1f1f;border:1px solid #ff8a7a;border-radius:8px;padding:12px 14px;color:#ffd6cf;font-size:14px}
  @media (max-width:560px){.ci__row{grid-template-columns:1fr}.ci__btn{width:100%}}
</style>

<div class="ci" id="custom-inquiry" {{ section.shopify_attributes }}>
  <div class="ci__in">
    <div class="ci__txt">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <button type="button" class="ci__btn" data-ci-open>{{ section.settings.button_label | escape }}</button>
  </div>

  <dialog data-ci-dialog aria-labelledby="CiTitle-{{ section.id }}">
    {%- form 'contact', id: 'CustomInquiry', class: 'ci__form' -%}
      <h3 id="CiTitle-{{ section.id }}">{{ section.settings.form_title | escape }}</h3>
      {%- if form.posted_successfully? -%}
        <div class="ci__ok" role="status" data-ci-posted>{{ section.settings.success_text | escape }}</div>
      {%- else -%}
        {%- if form.errors -%}<div class="ci__err" role="alert" data-ci-posted>{{ form.errors | default_errors }}</div>{%- endif -%}
        {%- if section.settings.form_text != blank -%}<p>{{ section.settings.form_text }}</p>{%- endif -%}
        <input type="hidden" name="contact[Inquiry]" value="{{ topic | escape }}">
        <input type="hidden" name="contact[Page]" value="{{ canonical_url | escape }}">
        <div class="ci__row">
          <div><label for="CiName-{{ section.id }}">{{ section.settings.name_label | escape }}</label><input id="CiName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required></div>
          <div><label for="CiPhone-{{ section.id }}">{{ section.settings.phone_label | escape }}</label><input id="CiPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel"></div>
        </div>
        <div><label for="CiEmail-{{ section.id }}">{{ section.settings.email_label | escape }}</label><input id="CiEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required></div>
        <div><label for="CiMsg-{{ section.id }}">{{ section.settings.message_label | escape }}</label><textarea id="CiMsg-{{ section.id }}" name="contact[body]" placeholder="{{ section.settings.message_placeholder | escape }}" required></textarea></div>
        {%- if section.settings.fine_print != blank -%}<p>{{ section.settings.fine_print }}</p>{%- endif -%}
      {%- endif -%}
      <div class="ci__acts">
        <button type="button" class="ci__ghost" data-ci-close>{{ section.settings.close_label | escape }}</button>
        {%- unless form.posted_successfully? -%}<button type="submit" class="ci__btn">{{ section.settings.submit_label | escape }}</button>{%- endunless -%}
      </div>
    {%- endform -%}
  </dialog>
</div>

<script>
  (function () {
    var root = document.getElementById('custom-inquiry');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var dlg = root.querySelector('[data-ci-dialog]');
    function open() { try { dlg.showModal(); } catch (e) { dlg.setAttribute('open', ''); } }
    root.querySelector('[data-ci-open]').addEventListener('click', open);
    root.querySelector('[data-ci-close]').addEventListener('click', function () { dlg.close(); });
    if (root.querySelector('[data-ci-posted]')) open();
  })();
</script>

{% schema %}
{
  "name": "Custom inquiry",
  "tag": "section",
  "class": "section-custom-inquiry",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Want a completely custom suit?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bring your own design, colours or team livery. Tell us your idea and we will prepare a design and quote together with FREEM.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send an inquiry" },
    { "type": "text", "id": "topic", "label": "Inquiry topic", "info": "Sent with the inquiry. Leave empty to use the product title." },
    { "type": "text", "id": "form_title", "label": "Form title", "default": "Fully custom suit inquiry" },
    { "type": "richtext", "id": "form_text", "label": "Form text", "default": "<p>Describe your idea: colours, logos, references and your race series. We reply within 1–2 working days. You can send logos and sketches when replying to our email.</p>" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Your idea" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "Colours, logos, references, deadline…" },
    { "type": "richtext", "id": "fine_print", "label": "Fine print" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send inquiry" },
    { "type": "text", "id": "close_label", "label": "Close button", "default": "Close" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you! We received your inquiry and will get back to you soon." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#1f212b" },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#6fd3c0" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [{ "name": "Custom inquiry" }]
}
{% endschema %}
