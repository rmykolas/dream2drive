{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    {%- liquid
      assign options_count = product.options_with_values | size
      assign has_single_option = false
      if options_count == 1
        assign has_single_option = true
      endif
      assign all_variants_have_image = true

      if has_single_option
        for v in product.variants
          if v.featured_image == nil
            assign all_variants_have_image = false
          endif
        endfor
      endif
    -%}

    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign has_metafield_swatches = false
        assign picker_type = block.settings.picker_type

        assign option_metafield_key = option.name | downcase | replace: ' ', '_' | replace: '-', '_'
        assign candidate_metafield = product.metafields.custom[option_metafield_key]

        if candidate_metafield != blank and candidate_metafield.value != blank
          for option_value in option.values
            assign normalized_option_value = option_value | strip | downcase

            for metaobject in candidate_metafield.value
              if metaobject.title != blank
                assign normalized_metaobject_label = metaobject.title | strip | downcase
                if normalized_metaobject_label == normalized_option_value
                  assign has_metafield_swatches = true
                  break
                endif
              endif
            endfor

            if has_metafield_swatches
              break
            endif
          endfor
        endif

        if block.settings.swatch_shape != 'none'
          if swatch_count > 0 or has_metafield_swatches
            if block.settings.picker_type == 'dropdown'
              assign picker_type = 'swatch_dropdown'
            else
              assign picker_type = 'swatch'
            endif
          endif
        endif

        assign use_variant_cards = false
        if has_single_option and all_variants_have_image and swatch_count == 0 and has_metafield_swatches == false
          assign use_variant_cards = true
        endif
      -%}

      {%- if use_variant_cards -%}
        {%- liquid
          assign product_form_id = 'product-form-' | append: section.id
        -%}
        <fieldset class="product-form__input">
          <legend class="form__label">
            {{ option.name }}
          </legend>

          <div class="bundle-variations">
            <div class="bundle-variations__group">
              <div class="bundle-variations__options">
                {%- for value in option.values -%}
                  {%- liquid
                    assign option_value = value
                    assign matching_variant = nil

                    for variant in product.variants
                      assign option_index = option.position | minus: 1
                      if variant.options[option_index] == option_value
                        assign matching_variant = variant
                        break
                      endif
                    endfor

                    if matching_variant == nil or matching_variant.featured_image == nil
                      continue
                    endif

                    assign is_available = matching_variant.available
                  -%}
                  <label
                    class="bundle-variations__option{% unless is_available %} bundle-variations__option--unavailable{% endunless %}"
                  >
                    <input
                      type="radio"
                      name="options[{{ option.name | escape }}]"
                      value="{{ option_value | escape }}"
                      form="{{ product_form_id }}"
                      class="visually-hidden"
                      data-product-url="{{ value.product_url }}"
                      data-option-value-id="{{ value.id }}"
                      {% if matching_variant == product.selected_or_first_available_variant %}checked{% endif %}
                      {% unless is_available %}disabled{% endunless %}
                    >
                    <div class="bundle-variations__option-media">
                      {{ matching_variant.featured_image
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          class: 'bundle-variations__option-image'
                      }}
                      {%- unless is_available -%}
                        <span class="bundle-variations__badge">
                          {{ 'products.product.inventory_out_of_stock' | t }}
                        </span>
                      {%- endunless -%}
                    </div>
                    <div class="bundle-variations__option-body">
                      <p class="bundle-variations__option-title">
                        {{ matching_variant.title }}
                      </p>
                      <div class="bundle-variations__option-meta">
                        <p class="bundle-variations__option-stock">
                          {%- if is_available -%}
                            {{ 'products.product.inventory_in_stock' | t }}
                          {%- else -%}
                            {{ 'products.product.inventory_out_of_stock' | t }}
                          {%- endif -%}
                        </p>
                        <p class="bundle-variations__option-price">
                          {{ matching_variant.price | money }}
                        </p>
                      </div>
                    </div>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          </div>
        </fieldset>
      {%- elsif picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name }}: 
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">{{ option.name }}</legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- liquid
      assign product_form_id = 'product-form-' | append: section.id
    -%}

    {%- comment -%}
      Custom color properties (primary/secondary/tertiary) rendered as swatches from product metafields.
      These inputs populate `properties[...]` so they show up on the cart line item without adding
      extra Shopify product options (avoids variant limit issues).
    {%- endcomment -%}

    {%- if block.settings.swatch_shape != 'none' -%}
      {%- assign primary_colors = product.metafields.custom.primary_color.value -%}
      {%- assign secondary_colors = product.metafields.custom.secondary_color.value -%}
      {%- assign tertiary_colors = product.metafields.custom.tertiary_color.value -%}

      {%- if primary_colors != blank -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ product.metafields.custom.primary_color_label.value | default: 'Primary Color' }}:
            <span data-selected-value>
              {%- assign primary_default_title = '' -%}
              {%- for metaobject in primary_colors -%}
                {%- assign primary_default_title = metaobject.title -%}
                {%- break -%}
              {%- endfor -%}
              {{- primary_default_title -}}
            </span>
          </legend>
          {%- for metaobject in primary_colors -%}
            {%- liquid
              assign swatch_color = metaobject.color
            -%}
            <input
              type="radio"
              class="swatch-input__input"
              id="primary-color-{{ forloop.index0 }}"
              name="properties[Primary Color]"
              value="{{ metaobject.title | escape }}"
              form="{{ product_form_id }}"
              {% if forloop.first %}checked{% endif %}
            >
            <label
              for="primary-color-{{ forloop.index0 }}"
              class="swatch-input__label{% if block.settings.swatch_shape == 'square' %} swatch-input__label--square{% endif %}"
              title="{{ metaobject.title | escape }}"
            >
              <span
                class="swatch{% if block.settings.swatch_shape == 'square' %} swatch--square{% endif %}"
                style="--swatch--background: {{ swatch_color }};"
              ></span>
              <span class="visually-hidden">{{ metaobject.title | escape }}</span>
            </label>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}

      {%- if secondary_colors != blank -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ product.metafields.custom.secondary_color_label.value | default: 'Secondary Color' }}:
            <span data-selected-value>
              {%- assign secondary_default_title = '' -%}
              {%- for metaobject in secondary_colors -%}
                {%- assign secondary_default_title = metaobject.title -%}
                {%- break -%}
              {%- endfor -%}
              {{- secondary_default_title -}}
            </span>
          </legend>
          {%- for metaobject in secondary_colors -%}
            {%- liquid
              assign swatch_color = metaobject.color
            -%}
            <input
              type="radio"
              class="swatch-input__input"
              id="secondary-color-{{ forloop.index0 }}"
              name="properties[Secondary Color]"
              value="{{ metaobject.title | escape }}"
              form="{{ product_form_id }}"
              {% if forloop.first %}checked{% endif %}
            >
            <label
              for="secondary-color-{{ forloop.index0 }}"
              class="swatch-input__label{% if block.settings.swatch_shape == 'square' %} swatch-input__label--square{% endif %}"
              title="{{ metaobject.title | escape }}"
            >
              <span
                class="swatch{% if block.settings.swatch_shape == 'square' %} swatch--square{% endif %}"
                style="--swatch--background: {{ swatch_color }};"
              ></span>
              <span class="visually-hidden">{{ metaobject.title | escape }}</span>
            </label>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}

      {%- if tertiary_colors != blank -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ product.metafields.custom.tertiary_color_label.value | default: 'Tertiary Color' }}:
            <span data-selected-value>
              {%- assign tertiary_default_title = '' -%}
              {%- for metaobject in tertiary_colors -%}
                {%- assign tertiary_default_title = metaobject.title -%}
                {%- break -%}
              {%- endfor -%}
              {{- tertiary_default_title -}}
            </span>
          </legend>
          {%- for metaobject in tertiary_colors -%}
            {%- liquid
              assign swatch_color = metaobject.color
            -%}
            <input
              type="radio"
              class="swatch-input__input"
              id="tertiary-color-{{ forloop.index0 }}"
              name="properties[Tertiary Color]"
              value="{{ metaobject.title | escape }}"
              form="{{ product_form_id }}"
              {% if forloop.first %}checked{% endif %}
            >
            <label
              for="tertiary-color-{{ forloop.index0 }}"
              class="swatch-input__label{% if block.settings.swatch_shape == 'square' %} swatch-input__label--square{% endif %}"
              title="{{ metaobject.title | escape }}"
            >
              <span
                class="swatch{% if block.settings.swatch_shape == 'square' %} swatch--square{% endif %}"
                style="--swatch--background: {{ swatch_color }};"
              ></span>
              <span class="visually-hidden">{{ metaobject.title | escape }}</span>
            </label>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}
    {%- endif -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
