{%- comment -%}
  One configurator option (used by main-product.liquid → product_bundle_variations).
  Params:
    variant          – the variant added to cart
    item             – product the variant belongs to (image fallback)
    group_title      – group name (data-product-title)
    label            – title shown on the option
    description_html – optional HTML for the info dialog
    link             – optional URL for the "View product" button
  Product metafield custom.config_max_qty (integer) > 1 shows a quantity selector
  under the option once it is selected (e.g. 3 monitors for a triple stand).
{%- endcomment -%}
{%- liquid
  assign is_available = variant.available
  assign inventory_quantity = variant.inventory_quantity | default: 0
  assign option_image = variant.featured_image | default: item.featured_image
  assign max_qty = item.metafields.custom.config_max_qty.value | default: 1
  if max_qty < 1
    assign max_qty = 1
  endif
-%}
<div class="bundle-variations__option-wrapper{% if description_html != blank %} bundle-variations__option-wrapper--has-info{% endif %}" style="position:relative;">
  <button
    type="button"
    class="bundle-variations__option{% unless is_available %} bundle-variations__option--unavailable{% endunless %}"
    data-variant-id="{{ variant.id }}"
    data-price="{{ variant.price | divided_by: 100.0 }}"
    data-product-title="{{ group_title | escape }}"
    data-option-title="{{ label | escape }}"
    data-available="{{ is_available }}"
    data-inventory="{{ inventory_quantity }}"
    data-inventory-tracked="{% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' %}true{% else %}false{% endif %}"
    data-max-qty="{{ max_qty }}"
    data-qty="1"
    {% unless is_available %}aria-disabled="true"{% endunless %}
  >
    <div class="bundle-variations__option-media">
      {%- if option_image -%}
        {{ option_image
          | image_url: width: 300
          | image_tag:
            loading: 'lazy',
            class: 'bundle-variations__option-image'
        }}
      {%- endif -%}
      {%- unless is_available -%}
        <span class="bundle-variations__badge">
          {{ 'products.product.inventory_out_of_stock' | t }}
        </span>
      {%- endunless -%}
    </div>
    <div class="bundle-variations__option-body">
      <p class="bundle-variations__option-title">
        {{ label }}
      </p>
      <div class="bundle-variations__option-meta">
        <p class="bundle-variations__option-stock">
          {%- if is_available -%}
            {{ 'products.product.inventory_in_stock' | t }}
          {%- else -%}
            {{ 'products.product.inventory_out_of_stock' | t }}
          {%- endif -%}
        </p>
        <p class="bundle-variations__option-price">
          {{ variant.price | money }}
        </p>
      </div>
    </div>
  </button>
  {%- if max_qty > 1 and is_available -%}
    <div
      class="bundle-variations__qty"
      data-bundle-qty
      style="display:none;position:absolute;left:10px;bottom:10px;z-index:2;align-items:center;background:#282C37;border:1px solid #66C2A4;height:34px;"
    >
      <button
        type="button"
        data-bundle-qty-minus
        aria-label="{{ 'products.product.quantity.decrease' | t: product: label | escape }}"
        style="width:34px;height:32px;background:none;border:0;color:#fff;font-size:18px;line-height:1;cursor:pointer;padding:0;"
      >−</button>
      <span
        data-bundle-qty-value
        aria-live="polite"
        style="min-width:26px;text-align:center;color:#fff;font-size:16px;font-weight:500;"
      >1</span>
      <button
        type="button"
        data-bundle-qty-plus
        aria-label="{{ 'products.product.quantity.increase' | t: product: label | escape }}"
        style="width:34px;height:32px;background:none;border:0;color:#fff;font-size:18px;line-height:1;cursor:pointer;padding:0;"
      >+</button>
    </div>
  {%- endif -%}
  {%- if description_html != blank -%}
    <button
      type="button"
      class="bundle-variations__info-toggle focus-inset"
      data-bundle-info-open="BundleInfoDialog-{{ variant.id }}"
      aria-haspopup="dialog"
      aria-controls="BundleInfoDialog-{{ variant.id }}"
      aria-label="{{ 'products.product.bundle_variations_info' | t }}"
    >
      <span class="bundle-variations__info-icon" aria-hidden="true">
        {{ 'icon-info-circle.svg' | inline_asset_content }}
      </span>
      <span class="visually-hidden">
        {{ 'products.product.bundle_variations_info' | t }}
      </span>
    </button>
    <dialog
      id="BundleInfoDialog-{{ variant.id }}"
      class="bundle-variations__dialog"
      aria-labelledby="BundleInfoDialogTitle-{{ variant.id }}"
    >
      <div class="bundle-variations__dialog-inner feature-content">
        <button
          type="button"
          class="bundle-variations__dialog-close link focus-inset"
          data-bundle-info-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
        <h2
          id="BundleInfoDialogTitle-{{ variant.id }}"
          class="bundle-variations__info-heading"
        >
          {{ label }}
        </h2>
        <div class="bundle-variations__dialog-content rte">
          {{ description_html }}
        </div>
        {%- if link != blank -%}
          <a
            href="{{ link }}"
            class="bundle-variations__dialog-link px-[30px] py-[18.5px] text-[17px] font-medium leading-[100%] tracking-[-0.02em] uppercase flex items-center w-fit bg-[#66c2a4] gap-[16px] mt-[20px] hover:bg-[#B6E3D9]"
          >
            {{ 'products.product.bundle_variations_view_product' | t }}
            <span class="bundle-variations__dialog-link-icon">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </a>
        {%- endif -%}
      </div>
    </dialog>
  {%- endif -%}
</div>
